{
  "mcpServers": {
    "pje": {
      "command": "node",
      "args": ["/usr/local/lib/node_modules/pje-mcp-server/build/index.js"],
      "env": {
        "NODE_ENV": "production"
      }
    }
  },
  "_comments": {
    "info": "Configuração para Claude Desktop no macOS",
    "location": "~/Library/Application Support/Claude/claude_desktop_config.json",
    "instalacao_global": "npm install -g pje-mcp-server",
    "configuracao_automatica": "npm run config:claude",
    "nota": "Se usar homebrew, o caminho pode ser /opt/homebrew/lib/node_modules/..."
  }
}
