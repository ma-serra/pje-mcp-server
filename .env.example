# ===================================
# PJE MCP Server - Configuração
# ===================================

# URL do seu tribunal PJE
PJE_BASE_URL=https://pje.tjce.jus.br

# Nome da aplicação PJE (varia por tribunal)
# Exemplos:
# - TJCE: pje-tjce-1g
# - TRF5: pje-trf5-1g
# - TJMG: pje-tjmg-1g
PJE_APP_NAME=pje-tjce-1g

# ===================================
# Certificado Digital (escolha UMA opção)
# ===================================

# Opção 1: Arquivo PFX/P12 (A1)
# Caminho completo para o arquivo do certificado
PJE_CERTIFICATE_PFX_PATH=/caminho/para/certificado.pfx
# ou no Windows:
# PJE_CERTIFICATE_PFX_PATH=C:\Users\usuario\certificado.pfx

# Senha do arquivo PFX
PJE_CERTIFICATE_PFX_PASSWORD=senha_do_certificado

# Opção 2: Windows Certificate Store (A3 ou A1 instalado)
# Thumbprint do certificado (somente Windows)
# Para descobrir: certutil -store My
# PJE_CERTIFICATE_THUMBPRINT=ABC123DEF456...

# ===================================
# Configurações Avançadas (Opcional)
# ===================================

# Ambiente de execução
NODE_ENV=production

# Debug (descomente para ativar logs detalhados)
# PJE_DEBUG=true

# Timeout para requisições (em ms)
# PJE_REQUEST_TIMEOUT=30000

# ===================================
# Notas Importantes
# ===================================
#
# 1. Certificados:
#    - Arquivo PFX: Mais simples, funciona em todos os sistemas
#    - Windows Store: Apenas Windows, útil para certificados A3
#
# 2. Segurança:
#    - NUNCA commit este arquivo com senhas reais
#    - Use variáveis de ambiente do sistema em produção
#    - Mantenha o certificado em local seguro
#
# 3. Tribunais:
#    - A URL e app_name variam por tribunal
#    - Consulte a documentação do tribunal específico
#
# 4. Testando:
#    - Use "pje_status" no Claude para verificar configuração
#    - Use "pje_info_certificado" para validar o certificado
#
